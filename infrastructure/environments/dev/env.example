# Monolith Docs — Dev Environment (GCE VM)
# Copy to .env on the VM at /opt/monolith-docs/.env

NODE_ENV=development
ONLYOFFICE_JWT_SECRET=<generate: openssl rand -hex 32; used as text (UTF-8), never decoded; at least 32 bytes>

PORT=3020
HOST=0.0.0.0
LOG_LEVEL=info
ONLYOFFICE_URL=http://onlyoffice:80
ONLYOFFICE_PUBLIC_URL=https://app.monolithdocs.com
API_PUBLIC_URL=https://app.monolithdocs.com
API_INTERNAL_URL=http://editor-api:3020

CORS_ORIGINS=https://app.monolithdocs.com

# Consumer auth — configure for dev testing
# CONSUMER_API_KEY=<dev-test-key>
# CONSUMERS='[...]'

# Rate limiting
RATE_LIMIT_MAX=200

# Editor service (EDIT-2). EDITOR_ENV unset means production rules; set it explicitly.
EDITOR_ENV=dev
# Sealed editor URL keys: current first, then the previous one during rotation (32 bytes each).
EDITOR_SEAL_KEYS=<generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">
# Origins DocumentServer's save URLs may carry (default: ONLYOFFICE_URL and ONLYOFFICE_PUBLIC_URL origins).
# ONLYOFFICE_CALLBACK_URL_ORIGINS=http://onlyoffice,https://app.monolithdocs.com
# Proxies whose forwarded client address to believe: their addresses or CIDRs, or proxy-addr's named
# private ranges. Never a hop count (Fastify 5.12 ignores one and trusts no proxy, so startup refuses
# it) and never everyone (startup refuses an entry it cannot parse, an IPv6 range broader than /32, or
# anything covering more than one IPv4 /8). X-Forwarded-Host is always ignored, so
# trusting a proxy never changes a consumer's hostname binding. Unset means none.
# TRUST_PROXY=172.18.0.0/16
# The source route's limits when the service fetches a consumer's file for DocumentServer (defaults shown).
# EDITOR_SOURCE_TIMEOUT_MS=30000
# EDITOR_MAX_SOURCE_BYTES=104857600
# Source reads held in memory at once (each holds its whole file until complete, ADR F17).
# Memory ceiling for files: (EDITOR_SOURCE_CONCURRENCY + EDITOR_CONVERT_CONCURRENCY_TOTAL) x 100 MB
# (each file is held once: kept as received, sent on as views, never joined or copied).
# EDITOR_SOURCE_CONCURRENCY=4
# Conversion (EDIT-3): the request's deadline, concurrent conversions per consumer, the PDF's cap.
# EDITOR_CONVERT_TIMEOUT_MS=90000
# EDITOR_CONVERT_CONCURRENCY=2
# EDITOR_CONVERT_CONCURRENCY_TOTAL=4
# EDITOR_MAX_CONVERT_OUTPUT_BYTES=104857600
# One notification secret per profile-capable consumer, named by its notificationSecretRef:
# EDITOR_NOTIFY_SECRET_CRM=<generate: openssl rand -hex 32; used as text (UTF-8), never decoded; at least 32 bytes>
# EDITOR_NOTIFY_SECRET_CRM_PREVIOUS=<only during rotation>
