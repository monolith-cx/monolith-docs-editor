# The editor API's env file on the VPS: /srv/monolith/<env>/env/editor-api.env (0600, generated
# from 1Password, never committed). Names and shapes only; every value marked <op> lives in 1Password
# and, by the Secret Lifecycle rule, in Google Secret Manager (project monolith-docs) too.
# The compose fragment sets NODE_ENV, PORT, HOST, ONLYOFFICE_URL, and API_INTERNAL_URL itself.

# Strict rules (E4). dev for the dev project, production for prod.
EDITOR_ENV=dev
LOG_LEVEL=info

# The public host (Caddy); the editor page, the bridge plugin, and DocumentServer's browser assets.
ONLYOFFICE_PUBLIC_URL=https://editor-dev.monolith.cx
API_PUBLIC_URL=https://editor-dev.monolith.cx
# DocumentServer's save URLs: its internal origin and the public one (the default derives exactly these).
# ONLYOFFICE_CALLBACK_URL_ORIGINS=http://editor-documentserver-dev,https://editor-dev.monolith.cx

# <op> At least 32 bytes, used as text. The same value is editor-documentserver.env's JWT_SECRET.
ONLYOFFICE_JWT_SECRET=<op>
# <op> Sealed editor URL keys: current first, then the previous one during rotation (32 bytes each, base64url).
EDITOR_SEAL_KEYS=<op>

# The registered consumers (E5), one JSON array. In dev: the UDOC-1.6 acceptance stub, then CRM dev at
# UDOC-3. Consumers on the box call http://editor-api:3020, so their hostname binding (if any) is
# "editor-api"; only one consumer can be bound to a hostname.
CONSUMERS=<json>
# <op> One notification secret per consumer, named by its notificationSecretRef (EDITOR_NOTIFY_SECRET_<NAME>).
EDITOR_NOTIFY_SECRET_ACCEPTANCE=<op>

# Exact browser origins allowed to call the API cross-origin (none need to in dev: consumers call it server-side).
CORS_ORIGINS=https://editor-dev.monolith.cx

# One proxy hop: Caddy. Callers on the box connect directly and send no forwarded header.
TRUST_PROXY=1
RATE_LIMIT_MAX=200

# The limits keep their defaults (EDIT-3, ADR F17); listed so a change here is deliberate.
# EDITOR_SOURCE_TIMEOUT_MS=30000
# EDITOR_MAX_SOURCE_BYTES=104857600
# EDITOR_SOURCE_CONCURRENCY=4
# EDITOR_CONVERT_TIMEOUT_MS=90000
# EDITOR_CONVERT_CONCURRENCY=2
# EDITOR_CONVERT_CONCURRENCY_TOTAL=4
