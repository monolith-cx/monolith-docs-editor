# Monolith Docs — Local Development Environment
# Copy to .env and customize as needed

# OnlyOffice JWT secret — this default is for local dev only
ONLYOFFICE_JWT_SECRET=dev-only-secret-do-not-use-in-prod

# Strictness (EDIT-2.1): unset means production, which refuses weak secrets, http URLs, and
# api-key consumers. Only `local` relaxes them.
EDITOR_ENV=local

# Sealed editor URLs: one or two base64url 32-byte keys, current first. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The service refuses to start without one.
EDITOR_SEAL_KEYS=

# Consumer auth — with no consumers configured under EDITOR_ENV=local, requests act as an
# anonymous local consumer (legacy shape only). To test with auth locally, uncomment and configure:
# CONSUMER_API_KEY=dev-test-key
# CONSUMERS='[{"id":"dev","name":"Dev Consumer","auth":{"mode":"api-key","key":"dev-test-key"}}]'

# CORS — leave empty for local dev (allows all origins)
# CORS_ORIGINS=http://localhost:3020

# Rate limiting (requests per minute)
# RATE_LIMIT_MAX=100

# Longest editor session (milliseconds, at most and by default 12 hours)
# EDITOR_MAX_SESSION_MS=43200000

# A profile consumer's notification secret, named by its notificationSecretRef
# EDITOR_NOTIFY_SECRET_DEV=

# OnlyOffice URLs (defaults work with docker-compose)
# ONLYOFFICE_PUBLIC_URL=http://localhost:8080
# API_PUBLIC_URL=http://localhost:3020
